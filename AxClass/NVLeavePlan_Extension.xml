				<Source><![CDATA[
    static boolean nvAccrualFrequencyHasAccrualPeriods(LeavePlanAccrualFrequency _accrualFrequency)
    {
        return
            _accrualFrequency != LeavePlanAccrualFrequency::NoAccruals
            && _accrualFrequency != LeavePlanAccrualFrequency::None;
    }

]]></Source>
