            qbr.value(SysQueryRangeUtil::value(_rehire));
            qbr.status(RangeStatus::Locked);
        }

        SysTableLookup  sysTableLookup = SysTableLookup::newParameters(tableNum(NVHcmWorkerHireReason), sender);
        
        sysTableLookup.addLookupField(fieldNum(NVHcmWorkerHireReason, Id));
        sysTableLookup.addLookupField(fieldNum(NVHcmWorkerHireReason, Name));

        sysTableLookup.parmQuery(query);
        sysTableLookup.performFormLookup();
    }

