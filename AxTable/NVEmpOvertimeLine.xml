    /// </summary>
    public void write()
    {
        if(this.DayTimeHours)
        {
            this.DayMinutes = this.convertHoursMinutesToMinutes(this.DayTimeHours);
        }
        if(this.NightTimeHours)
        {
            this.NightMinutes = this.convertHoursMinutesToMinutes(this.NightTimeHours);
        }
        super();
    }

]]></Source>
