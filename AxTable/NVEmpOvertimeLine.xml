			<Method>
				<Name>convertHoursMinutesToMinutes</Name>
				<Source><![CDATA[
    int convertHoursMinutesToMinutes(str _timeStr)
    {
        int hours;
        int minutes;
        str hoursStr;
        str minutesStr;
        
        #define.Delimiter(':')
    
        
        int delimiterPos = strScan(_timeStr, #Delimiter, 1, strLen(_timeStr));
    
        if (delimiterPos == 0)
        {
            hours = str2num(_timeStr);
            minutes = 0;
        }
        else
        {
            hoursStr = subStr(_timeStr, 1, delimiterPos - 1);
            hours = str2num(hoursStr);
        
            minutesStr = subStr(_timeStr, delimiterPos + 1, strLen(_timeStr));
            minutes = str2num(minutesStr);
        }
    
        return (hours * 60) + minutes;
    }

]]></Source>
			</Method>
			<Method>
				<Name>write</Name>
				<Source><![CDATA[
    /// <summary>
