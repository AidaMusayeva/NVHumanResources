			<Method>
				<Name>findByPosition</Name>
				<Source><![CDATA[
    public static NVPositionOvertimeGroup findByPosition(
                                            HcmPositionRecId    _position,
                                            TransDate         _validFrom = systemDateGet(),
                                            TransDate         _validTo   = _validFrom,
                                            boolean             _forUpdate = false,
                                            ConcurrencyModel    _concurrencyModel = ConcurrencyModel::Auto)
    {
        NVPositionOvertimeGroup NVPositionOvertimeGroup;

        NVPositionOvertimeGroup.selectForUpdate(_forUpdate );
        if (_forUpdate && _concurrencyModel != ConcurrencyModel::Auto)
        {
            NVPositionOvertimeGroup.concurrencyModel(_concurrencyModel);
        }

        if (_position)
        {
            if (prmisdefault(_validFrom) && prmisdefault(_validTo))
            {
                select firstonly NVPositionOvertimeGroup
                    where NVPositionOvertimeGroup.Position == _position;
            }
            else if (_validFrom == _validTo)
            {
                select firstonly ValidTimeState(_validFrom) NVPositionOvertimeGroup
                    where NVPositionOvertimeGroup.Position == _position;
            }
            else
            {
                select ValidTimeState(_validFrom, _validTo) NVPositionOvertimeGroup
                    where NVPositionOvertimeGroup.Position == _position;
            }
        }

        return NVPositionOvertimeGroup;
    }

]]></Source>
