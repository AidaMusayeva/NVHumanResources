    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();
    
        if(NVHcmDisability::find(this.DisabilityId).IsActive == NoYes::No)
        {
            ret = checkFailed(strFmt("%1 has been deactivated.", this.DisabilityId));
        }

        return ret;
    }

]]></Source>
