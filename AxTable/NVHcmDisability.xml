			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static NVHcmDisability find(NVHcmDisabilityId _Id)
    {
        NVHcmDisability disability;

        select firstonly disability
            where disability.Id == _Id;

        return disability;
    }

]]></Source>
