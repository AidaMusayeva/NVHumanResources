				<Source><![CDATA[
    public static void disabilityLookup(FormControl sender)
    {
        Query query = new Query();
        QueryBuildDataSource qbds = query.addDataSource(tableNum(NVHcmDisability));
        
        qbds.addRange(fieldNum(NVHcmDisability, IsActive)).value(SysQuery::value(NoYes::Yes));

        SysTableLookup  sysTableLookup = SysTableLookup::newParameters(tableNum(NVHcmDisability), sender);
        
        sysTableLookup.addLookupField(fieldNum(NVHcmDisability, Id));
        sysTableLookup.addLookupField(fieldNum(NVHcmDisability, Name));

        sysTableLookup.parmQuery(query);
        sysTableLookup.performFormLookup();
    }

]]></Source>
