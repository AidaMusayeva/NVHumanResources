		<Methods>
			<Method>
				<Name>findPerDiem</Name>
				<Source><![CDATA[
    public static NVTrvWorkerLocationPerDiem findPerDiem(NVTrvWorkerLocationId _from, NVTrvWorkerLocationId _to)
    {
        NVTrvWorkerLocationPerDiem locationPerDiem;

        select locationPerDiem
            where locationPerDiem.FromLocation    == _from
                && locationPerDiem.ToLocation     == _to;

        return locationPerDiem;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();
    
        if(this.FromLocation == this.ToLocation)
        {
            ret = checkFailed(strFmt("%1 and %2 cannot be same.", fieldPName(NVTrvWorkerLocationPerDiem, FromLocation), fieldPName(NVTrvWorkerLocationPerDiem, ToLocation)));
        }

        ret = this.validatePercentage();

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super();

        this.CurrencyCode = Ledger::reportingCurrency();
    }

]]></Source>
			</Method>
			<Method>
				<Name>validatePercentage</Name>
				<Source><![CDATA[
    public boolean validatePercentage()
    {
        boolean ret = true;
    
        if((this.HotelPercent + this.OtherAllowancePercent) != 100)
        {
            ret = checkFailed(strFmt("Sum of %1 and %2 must be equal to 100"
                , fieldPName(NVTrvWorkerLocationPerDiem, HotelPercent)
                , fieldPName(NVTrvWorkerLocationPerDiem, OtherAllowancePercent)));
        }

        return ret;
    }

]]></Source>
			</Method>
