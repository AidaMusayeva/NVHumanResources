		<Methods>
			<Method>
				<Name>createAllByPlan</Name>
				<Source><![CDATA[
    public static void createAllByPlan(LeavePlan _plan)
    {
        if(!_plan)
            return;

        DictEnum dictEnum = new DictEnum(enumNum(NVLeaveCategory));
        int      valueCount = dictEnum.values();
        
        for (int incr = 0; incr < valueCount; incr++)
        {
            NVLeavePlanLeaveBalancePolicy balancePolicy;

            balancePolicy.LeavePlan     = _plan.RecId;
            balancePolicy.Category      = dictEnum.index2Value(incr);
            balancePolicy.Priority      = incr;

            balancePolicy.insert();
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByPlan</Name>
				<Source><![CDATA[
    public static NVLeavePlanLeaveBalancePolicy findByPlan(LeavePlanRecId _plan, NVLeaveCategory _category)
    {
        NVLeavePlanLeaveBalancePolicy balancePolicy;

        select firstonly balancePolicy
            where balancePolicy.LeavePlan == _plan
                && balancePolicy.Category == _category;

        return balancePolicy;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
