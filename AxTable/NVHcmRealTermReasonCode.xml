				<Name>find</Name>
				<Source><![CDATA[
    public static NVHcmRealTermReasonCode find(
    NVHcmRealTermReasonCodeRecId         _recId,
    boolean             _forUpdate = false,
    ConcurrencyModel    _concurrencyModel = ConcurrencyModel::Auto)
    {
        NVHcmRealTermReasonCode hcmReasonCode;

        hcmReasonCode.selectForUpdate(_forUpdate );
        if (_forUpdate && _concurrencyModel != ConcurrencyModel::Auto)
        {
            hcmReasonCode.concurrencyModel(_concurrencyModel);
        }

        select firstonly hcmReasonCode
             where hcmReasonCode.RecId == _recId;

        return hcmReasonCode;
    }

]]></Source>
