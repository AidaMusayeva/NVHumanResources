		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static NVHcmEmailAlertsSetup find(NVHcmEmailAlertsType _type, boolean _forUpdate = false)
    {
        NVHcmEmailAlertsSetup hcmEmailAlerts;

        if(_forUpdate)
            hcmEmailAlerts.selectForUpdate(_forUpdate);
    
        select hcmEmailAlerts
            where hcmEmailAlerts.Type == _type;
        return hcmEmailAlerts;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    public static boolean exists(NVHcmEmailAlertsType _type)
    {
        return (select NVHcmEmailAlertsSetup
            where NVHcmEmailAlertsSetup.Type == _type).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>createNotFoundAll</Name>
				<Source><![CDATA[
    public static void createNotFoundAll()
    {
        NVHcmEmailAlertsSetup::createNotFound(NVHcmEmailAlertsType::ContractExpiry);
        NVHcmEmailAlertsSetup::createNotFound(NVHcmEmailAlertsType::ProbationExpiry);
        NVHcmEmailAlertsSetup::createNotFound(NVHcmEmailAlertsType::IdentExpiry);
        NVHcmEmailAlertsSetup::createNotFound(NVHcmEmailAlertsType::PositionReplacement);
        NVHcmEmailAlertsSetup::createNotFound(NVHcmEmailAlertsType::WorkerResidence);
        NVHcmEmailAlertsSetup::createNotFound(NVHcmEmailAlertsType::WorkPermit);
    }

]]></Source>
			</Method>
			<Method>
				<Name>createNotFound</Name>
				<Source><![CDATA[
    public static void createNotFound(NVHcmEmailAlertsType _type)
    {
        if(NVHcmEmailAlertsSetup::exists(_type))
            return;

        NVHcmEmailAlertsSetup hcmEmailAlerts;
        hcmEmailAlerts.Type = _type;
        hcmEmailAlerts.insert();
    }

]]></Source>
			</Method>
