		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static NvTimeSheetHeader find(PayrollPayCycleId _payCycle, RefRecId _payPeriod)
    {
        NvTimeSheetHeader   timeSheetHeader;

        select firstonly timeSheetHeader
            where timeSheetHeader.PayCycleId == _payCycle
            && timeSheetHeader.PayPeriod == _payPeriod;

        return timeSheetHeader;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByPayCyclePeriod</Name>
				<Source><![CDATA[
    public static NvTimeSheetHeader findByPayCyclePeriod(PayrollPayCycleId _payCycle, StartDate _startDate, EndDate _endDate)
    {
        NvTimeSheetHeader   timeSheetHeader;
        
        PayrollPayPeriod payPeriod = PayrollPayPeriod::findByPayCycleAndDateRange(PayrollPayCycle::findByPayCycle(_payCycle).RecId, _startDate);
        select firstonly crosscompany timeSheetHeader
            where timeSheetHeader.PayCycleId    == _payCycle
                && timeSheetHeader.PayPeriod    == payPeriod.RecId;

        return timeSheetHeader;
    }

]]></Source>
			</Method>
			<Method>
				<Name>LeaveTypeSequencingMap</Name>
				<Source><![CDATA[
    public Map LeaveTypeSequencingMap()
    {
        Map leaveMap = new Map(Types::String, Types::Integer);


        for (int i = 1; i <= conLen(this.LeaveTypesSequencing); i += 2)
        {
            str abbrevation = conPeek(this.LeaveTypesSequencing, i);
            int fieldnumber = conPeek(this.LeaveTypesSequencing, i + 1);
            
            leaveMap.insert(abbrevation, fieldnumber);
        }

        return leaveMap;
    }

]]></Source>
			</Method>
			<Method>
				<Name>serializeLeaveTypeMap</Name>
				<Source><![CDATA[
    public container serializeLeaveTypeMap(Map _leaveMap)
    {
        container serializedData;
        MapEnumerator enumerator = _leaveMap.getEnumerator();
        
        while (enumerator.moveNext())
        {
            serializedData += [enumerator.currentKey(), enumerator.currentValue()];
        }
        if(serializedData)
            this.LeaveTypesSequencing = serializedData;

        return serializedData;
    }

]]></Source>
			</Method>
