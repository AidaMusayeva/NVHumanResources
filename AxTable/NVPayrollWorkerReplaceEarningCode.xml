			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;

        ret = super(_fieldIdToCheck);

        if(_fieldIdToCheck == fieldNum(NVPayrollWorkerReplaceEarningCode, ReplacedPosition))
        {
            HcmWorkerRecId workerRecId = HcmPositionWorkerAssignment::findByPosition(this.ReplacedPosition).Worker;
            if(this.ReplacedWorker != 0 && workerRecId != this.ReplacedWorker)
            {
                HcmWorker   worker      = HcmWorker::find(this.ReplacedWorker);
                HcmPosition position    = HcmPosition::find(this.ReplacedPosition);
                
                ret = checkFailed(strFmt("%1 not assigned to %2.", position.description(), worker.name()));
            }
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        if(_fieldId == fieldNum(NVPayrollWorkerReplaceEarningCode, ReplacementMethod))
        {
            if(this.ReplacementMethod != NVPayrollReplacementMethod::Fixed)
            {
                this.Formula = 1;
            }
        }
        else if(_fieldId == fieldNum(NVPayrollWorkerReplaceEarningCode, ReplacedWorker))
        {
            if(this.ReplacedPosition == 0)
            {
                this.ReplacedPosition   = HcmPosition::findByPosition(HcmWorker::find(this.ReplacedWorker).primaryPositionId()).RecId;
            }
        }
        else if(_fieldId == fieldNum(NVPayrollWorkerReplaceEarningCode, ReplacedPosition))
        {
            this.ReplacedWorker         = HcmPositionWorkerAssignment::findByPosition(this.ReplacedPosition).Worker;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;

        ret = super();

        if (this.ReplacedEarningCode == 0 &&
            ((this.ReplacementMethod == NVPayrollReplacementMethod::Percentage && this.ReplacementMethodPerc == NVPayrollReplacementMethodPerc::ReplacedWorker)
            || this.ReplacementMethod == NVPayrollReplacementMethod::Difference))
        {
            ret = checkFailed(strFmt("%1 must be filled in.", fieldPName(NVPayrollWorkerReplaceEarningCode, ReplacedEarningCode)));
        }

        if (ret && this.ReplacedWorker == 0 && this.ReplacementMethod != NVPayrollReplacementMethod::Fixed)
        {
            ret = checkFailed(strFmt("%1 must be %2, if worker is not selected.", fieldPName(NVPayrollWorkerReplaceEarningCode, ReplacementMethod), this.ReplacementMethod));
        }

        if(ret
            && this.Position    != 0
            && this.Worker      != 0
            && !HcmPositionWorkerAssignment::existPositionWorker(this.Position, this.Worker))
        {
            HcmPosition position    = HcmPosition::find(this.Position);
            HcmWorker   worker      = HcmWorker::find(this.Worker);

            ret = checkFailed(strFmt("Position '%1' not assigned to worker '%2'", position.PositionId, worker.PersonnelNumber));
        }

        return ret;
    }

]]></Source>
