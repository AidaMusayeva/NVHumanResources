    public static boolean checkExist(RecId _recId)
    {
        boolean ret = true;

        if (!NVPayrollWorkerReplaceEarningCode::exist(_recId))
        {
            ret = checkFailed(strFmt(NVPayrollWorkerReplaceEarningCode::txtNotExist(), tableId2name(tableNum(NVPayrollWorkerReplaceEarningCode))));
        }

        return ret;
    }

