			<Method>
				<Name>existPosition</Name>
				<Source><![CDATA[
    public static boolean existPosition(HcmPositionRecId _positionRecId, date _checkDate = dateNull())
    {
        NVPayrollWorkerReplaceEarningCode payrollWorkerReplaceEarningCode;

        select firstonly payrollWorkerReplaceEarningCode
             where payrollWorkerReplaceEarningCode.ReplacedPosition == _positionRecId
                && (_checkDate == dateNull() ||
                    (payrollWorkerReplaceEarningCode.StartDate <= _checkDate && payrollWorkerReplaceEarningCode.EndDate >= _checkDate))
            ;

        boolean ret = (payrollWorkerReplaceEarningCode.RecId != 0);

        if(ret)
        {
            HcmPosition position    = HcmPosition::find(payrollWorkerReplaceEarningCode.ReplacedPosition);
            HcmWorker   worker      = HcmWorker::find(payrollWorkerReplaceEarningCode.Worker);

            warning(strFmt("%1 position is assigned to %2 as temporary replacement.", position.PositionId, worker.PersonnelNumber));
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static NVPayrollWorkerReplaceEarningCode find(
        RefRecId            _recId,
        boolean             _forUpdate = false)
    {
        NVPayrollWorkerReplaceEarningCode payrollWorkerReplaceEarningCode;
        ValidFromDate  validFrom = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
        ValidToDate    validTo   = dateMax();

        payrollWorkerReplaceEarningCode.selectForUpdate(_forUpdate );
       
        select firstonly payrollWorkerReplaceEarningCode
             where payrollWorkerReplaceEarningCode.RecId == _recId;

        return payrollWorkerReplaceEarningCode;
    }

]]></Source>
