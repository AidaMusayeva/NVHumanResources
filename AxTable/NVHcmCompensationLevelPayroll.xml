{ 
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super();

        this.ToDate = maxDate();
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;

        ret = super();

        ret = ret && this.validatDates();

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validatDates</Name>
				<Source><![CDATA[
    public boolean validatDates()
    {
        boolean ret = true;

        NVHcmCompensationLevelPayroll payrollLevel;

        select firstOnly payrollLevel
            where payrollLevel.RecId                != this.RecId
                && payrollLevel.CompensationLevelId == this.CompensationLevelId
                && payrollLevel.FromDate            <= this.ToDate
                && payrollLevel.ToDate              >= this.FromDate;

        if (payrollLevel.RecId)
        {
            ret = checkFailed("Overlapping date range exists.");
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findCurrent</Name>
				<Source><![CDATA[
    public static NVHcmCompensationLevelPayroll findCurrent(HcmCompensationLevelId _level)
    {
        NVHcmCompensationLevelPayroll levelPayroll;

        select firstonly levelPayroll
            where levelPayroll.CompensationLevelId  == _level
                && levelPayroll.FromDate           <= systemDateGet()
                && levelPayroll.ToDate             >= systemDateGet();

        return levelPayroll;
    }

]]></Source>
			</Method>
		</Methods>
