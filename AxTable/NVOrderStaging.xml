			<Method>
				<Name>displayEmployeeName</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display employee name from HcmWorker and DirPerson
    /// </summary>
    public display Name displayEmployeeName()
    {
        HcmWorker worker = HcmWorker::find(this.WorkerRecId);
        return worker.RecId ? DirPerson::find(worker.Person).Name : '';
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayPersonnelNumber</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display personnel number from HcmWorker
    /// </summary>
    public display HcmPersonnelNumberId displayPersonnelNumber()
    {
        HcmWorker worker = HcmWorker::find(this.WorkerRecId);
        return worker.RecId ? worker.PersonnelNumber : '';
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayEmployeeFIN</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display FIN from HcmPersonIdentificationNumber
    /// </summary>
    public display HcmIdentificationNumber displayEmployeeFIN()
    {
        HcmWorker worker = HcmWorker::find(this.WorkerRecId);
        HcmIdentificationType idType;
        HcmPersonIdentificationNumber identNumber;

        if (worker.RecId)
        {
            select firstonly idType where idType.IdentificationTypeId == 'FIN';
            
            if (idType.RecId)
            {
                identNumber = HcmPersonIdentificationNumber::findByPersonAndType(
                    worker.Person,
                    idType.RecId);
                
                return identNumber.IdentificationNumber;
            }
        }
        
        return '';
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayDepartmentName</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display department name from OMOperatingUnit
    /// </summary>
    public display Name displayDepartmentName()
    {
        OMOperatingUnit dept;
        
        select firstonly dept
            where dept.RecId == this.DepartmentRecId;
        
        return dept.Name;
    }

]]></Source>
