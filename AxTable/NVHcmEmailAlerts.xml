				<Name>findbyRef</Name>
				<Source><![CDATA[
    public static NVHcmEmailAlerts findbyRef(RefTableId _refTableId, RefRecId _refRecId, date _transDate)
    {
        NVHcmEmailAlerts alerts;

        select firstonly alerts
            where alerts.RefTableId     == _refTableId
                && alerts.RefRecId      == _refRecId
                && alerts.TransDate     == _transDate;
        
        return alerts;
    }

]]></Source>
