				<Name>validateField</Name>
				<Source><![CDATA[
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;

        ret = super(_fieldIdToCheck);

        switch(_fieldIdToCheck)
        {
            case fieldNum(NVHcmWorkerReferral, Phone):
                ret = this.validatePhoneNumber();
                break;

            case fieldNum(NVHcmWorkerReferral, Email):
                ret = this.validateEmail();
                break;
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validatePhoneNumber</Name>
				<Source><![CDATA[
    private boolean validatePhoneNumber()
    {
        boolean ret = true;
        str pattern = @"^\+?\d{1,3}[-.\s]?\(?\d{1,4}\)?[-.\s]?\d{1,4}[-.\s]?\d{1,9}$";
        System.Text.RegularExpressions.Regex regex = new System.Text.RegularExpressions.Regex(pattern);

        if (!regex.IsMatch(this.Phone))
        {
            ret = checkFailed("Invalid phone number.");
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateEmail</Name>
				<Source><![CDATA[
    private boolean validateEmail()
    {
        boolean ret = true;
        str pattern = @"^[\w\.-]+@[\w\.-]+\.\w{2,}$";
        System.Text.RegularExpressions.Regex regex = new System.Text.RegularExpressions.Regex(pattern);

        if (!regex.IsMatch(this.Email))
        {
            ret = checkFailed("Invalid email.");
        }

        return ret;
    }

]]></Source>
