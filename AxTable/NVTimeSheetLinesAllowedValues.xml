    public static boolean isAllowedValue(str _value)
    {
        NVTimeSheetLinesAllowedValues   allowedValues;

        if(isInteger(_value))
            return true;

        select firstonly RecId from allowedValues
            where allowedValues.Values == _value;

        return allowedValues.RecId !=0;
        
    }

]]></Source>
