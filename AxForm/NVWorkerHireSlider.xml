				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();

            str fin    = FINControl.text();
            str serial = SerialControl.text();

            NVWorkerHireService service = new NVWorkerHireService();

            NVWorkerHireContract contract =
        service.getWorkerData(fin, serial);
            NVWorkerHireResponse response =contract.parmResponse();
            

            if (!contract)
            {
                error("No data returned.");
                return;
            }

            if (contract.parmStatus().parmCode() != 0)
            {
                error(contract.parmStatus().parmMessage());
                return;
            }

            if (response.parmName())
            {
                Args formArgs = new Args();

                formArgs.caller(element);
                formArgs.parmObject(contract);

                MenuFunction menuFunction =
        new MenuFunction(
            menuItemDisplayStr(HcmWorkerNewWorker),
            MenuItemType::Display);

                menuFunction.run(formArgs);

                element.close();
            }
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
			<Control>
