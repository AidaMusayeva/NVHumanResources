			<Method>
				<Name>populateTotalExperience</Name>
				<Source><![CDATA[
    public void populateTotalExperience()
    {
        HcmWorker worker = this.args().record() as HcmWorker;
        
        NVHcmTotalExperienceTmp totalExperienceTmp = NVHcmTotalExperienceTmp::populateTotalExperience(worker);
        
        while select totalExperienceTmp
        {
            NVHcmTotalExperienceTmp.data(totalExperienceTmp);
            NVHcmTotalExperienceTmp.insert();
        }
        NVHcmTotalExperienceTmp_ds.refresh();
        NVHcmTotalExperienceTmp_ds.research(true);
    }

]]></Source>
