				<Source><![CDATA[
/// <summary>
/// Details form for viewing and editing a single employment order.
/// Displays order header and associated order lines.
/// </summary>
/// <remarks>
/// This form is typically opened from NVOrderList with a specific NVOrderHeader record in Args.
/// The form automatically filters to show only the selected order and its lines.
///
/// Delete behavior:
/// - Header delete: handled by standard ActionPane Delete button (uses NVOrderHeader_ds).
///   validateDelete() on NVOrderHeader_ds suppresses default dialog;
///   confirmation is shown in NVOrderHeader.validateDelete() (table level).
/// - Line delete: handled by DeleteLineButton.clicked() which explicitly
///   targets NVOrderLine_ds. UI validation lives in NVOrderLine_ds.validateDelete().
/// </remarks>
[Form]
public class NVOrderDetails extends FormRun
{
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initializes the form and filters data to the order passed in Args.
    /// If an NVOrderHeader record is provided, applies a RecId filter to the datasource.
    /// </summary>
    public void init()
    {
        NVOrderHeader        headerRec;
        QueryBuildDataSource qbds;
        
        super();
        
        if (element.args() && element.args().record())
        {
            if (element.args().record().TableId == tableNum(NVOrderHeader))
            {
                headerRec = element.args().record();
                
                // Filter NVOrderHeader datasource to show only the selected order
                qbds = NVOrderHeader_ds.queryBuildDataSource();
                qbds.clearRanges();
                qbds.addRange(fieldNum(NVOrderHeader, RecId))
                    .value(queryValue(headerRec.RecId));

                NVOrderHeader_ds.executeQuery();
            }
        }
    }

]]></Source>
