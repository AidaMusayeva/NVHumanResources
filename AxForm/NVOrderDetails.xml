        /// <summary>
        /// Suppresses the default framework "Delete record?" confirmation dialog.
        /// Confirmation is handled at table level in NVOrderHeader.validateDelete(),
        /// which shows a count-aware message before proceeding.
        /// </summary>
        public boolean validateDelete()
        {
            // Delegate to table-level validateDelete() via super().
            // Do NOT show a second dialog here — table already handles it.
