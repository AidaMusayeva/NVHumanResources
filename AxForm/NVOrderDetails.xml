					<Method>
						<Name>displayOption</Name>
						<Source><![CDATA[
        /// <summary>
        /// Applies row color coding based on order workflow status.
        /// </summary>
        public void displayOption(Common _record, FormRowDisplayOption _options)
        {
            NVOrderHeader header = _record;

            switch (header.Status)
            {
                case NVOrderStatus::PendingApproval:
                    _options.backColor(WinAPI::RGB2int(255, 243, 205));
                    break;

                case NVOrderStatus::Approved:
                    _options.backColor(WinAPI::RGB2int(212, 237, 218));
                    break;

                case NVOrderStatus::Rejected:
                    _options.backColor(WinAPI::RGB2int(248, 215, 218));
                    break;

                default:
                    break;
            }

            super(_record, _options);
        }

]]></Source>
