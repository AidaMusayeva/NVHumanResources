					<Method>
						<Name>validateDelete</Name>
						<Source><![CDATA[
        /// <summary>
        /// Validates deletion of a single order line from UI context only.
        /// Enforces business rules:
        ///   - Consolidated orders: cannot delete the last remaining line.
        ///   - All orders: requires explicit user confirmation.
        ///
        /// NOTE: super() is intentionally NOT called here to suppress the
        /// generic framework "Delete record?" dialog. Our custom Box::yesNo
        /// dialogs provide better business context to the user.
        /// This also prevents double-dialog issues during multi-select delete.
        ///
        /// This validation does NOT run during cascade delete from NVOrderHeader
        /// because cascade bypasses datasource validateDelete() entirely.
        /// </summary>
        /// <returns>True if deletion is allowed, false otherwise</returns>
        public boolean validateDelete()
        {
            NVOrderHeader header;
            NVOrderLine   lineCount;
            int           counts;

            header = NVOrderHeader_ds.cursor();

            if (!header.RecId)
            {
                error("Order header not found.");
                return false;
            }

            if (header.IsConsolidated == NoYes::Yes)
            {
                // Count remaining lines for this consolidated order
                select count(RecId) from lineCount
                    where lineCount.OrderHeaderRecId == header.RecId;

                counts = int642int(lineCount.RecId);

                if (counts <= 1)
                {
                    // Last line - user must delete entire order instead
                    error(strFmt("Cannot delete the last line in consolidated order %1. Delete the entire order instead.",
                        header.OrderNumber));
                    return false;
                }
            }

            // Single confirmation dialog for all cases - no double dialogs
            return true;
        }

]]></Source>
