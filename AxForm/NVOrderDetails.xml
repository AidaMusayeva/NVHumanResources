				<Name>DeleteLineButton</Name>
				<Type>CommandButton</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// Handles delete line button click with multi-select support.
        /// Collects all selected NVOrderLine records via MultiSelectionHelper,
        /// shows a single confirmation dialog for the entire selection,
        /// then deletes all selected lines in one transaction.
        ///
        /// Flow:
        /// 1. Collect selected lines via MultiSelectionHelper
        /// 2. Validate business rules (last line protection for consolidated)
        ///    by calling NVOrderLine_ds.validateDelete() once
        /// 3. Show single confirmation dialog
        /// 4. Delete all collected lines in ttsbegin/ttscommit
        /// 5. Refresh datasource
        /// </summary>
        public void clicked()
        {
            NVOrderHeader          header;
            NVOrderLine            line;
            MultiSelectionHelper   helper;
            List                   selectedRecIds;
            ListEnumerator         enumerator;
            NVOrderLine            lineToDelete;
            int                    selectedCount;
            int                    lineCount;
            NVOrderLine            lineCountBuf;

            header = NVOrderHeader_ds.cursor();

            if (!header.RecId)
            {
                error("Order header not found.");
                return;
            }

            // --- Step 1: Collect selected lines ---
            helper         = MultiSelectionHelper::construct();
            helper.parmDatasource(NVOrderLine_ds);
            selectedRecIds = new List(Types::Int64);
            selectedCount  = 0;

            line = helper.getFirst();
            while (line.RecId)
            {
                selectedRecIds.addEnd(line.RecId);
                selectedCount++;
                line = helper.getNext();
            }

            if (selectedCount == 0)
            {
                // Fallback: no multi-select, use current cursor
                line = NVOrderLine_ds.cursor();
                if (!line.RecId)
                {
                    error("No line selected.");
                    return;
                }
                selectedRecIds.addEnd(line.RecId);
                selectedCount = 1;
            }

            // --- Step 2: Business rule - last line protection for consolidated ---
            if (header.IsConsolidated == NoYes::Yes)
            {
                select count(RecId) from lineCountBuf
                    where lineCountBuf.OrderHeaderRecId == header.RecId;

                lineCount = int642int(lineCountBuf.RecId);

                if (lineCount - selectedCount < 1)
                {
                    error(strFmt("Cannot delete all lines in consolidated order %1. At least one line must remain. Delete the entire order instead.",
                        header.OrderNumber));
                    return;
                }
            }

            // --- Step 3: Single confirmation dialog for entire selection ---
            if (selectedCount == 1)
            {
                if (Box::yesNo(
                    strFmt("Delete selected line from order %1?", header.OrderNumber),
                    DialogButton::No) == DialogButton::No)
                {
                    return;
                }
            }
            else
            {
                if (Box::yesNo(
                    strFmt("Delete %1 selected lines from order %2?", selectedCount, header.OrderNumber),
                    DialogButton::No) == DialogButton::No)
                {
                    return;
                }
            }

            // --- Step 4: Delete all selected lines in one transaction ---
            ttsbegin;

            enumerator = selectedRecIds.getEnumerator();
            while (enumerator.moveNext())
            {
                lineToDelete = NVOrderLine::find(enumerator.current(), true);
                if (lineToDelete.RecId)
                {
                    lineToDelete.delete();
                }
            }

            ttscommit;

            // --- Step 5: Refresh datasource to reflect deletions ---
            NVOrderLine_ds.executeQuery();
        }

]]></Source>
