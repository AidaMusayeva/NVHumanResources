				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();
            LeaveRequest        leaveRequest;
            LeaveRequestDetail  leaveRequestDetail;
            NVTimeSheetLines    localTimeSheetLine;
            NvTimeSheetHeader   timeSheetHeader;
            PayrollPayPeriod    payrollPayPeriod;
            MultiSelectionHelper helper = MultiSelectionHelper::construct();
            
            helper.parmDatasource(NVTimeSheetLines_DS);
            localTimeSheetLine = helper.getFirst();
   
            timeSheetHeader = localTimeSheetLine.timeSheetHeader();
            payrollPayPeriod = PayrollPayPeriod::find(timeSheetHeader.PayPeriod);

            while(localTimeSheetLine)
            {
                if(!localTimeSheetLine.validateAllColumnsAreFilled())
                {
                    warning(strFmt('Cannot submit entry for employee %1 because of missing data in columns', localTimeSheetLine.EmpId));
                    localTimeSheetLine = NVTimeSheetLines_DS.getNext();
                    continue;
                }

                select RecId from leaveRequest       
                    where leaveRequest.Worker       == localTimeSheetLine.Worker
                        && (leaveRequest.Status     == LeaveRequestApprovalStatus::Draft
                            || leaveRequest.Status  == LeaveRequestApprovalStatus::InReview)
                    join LeaveDate from leaveRequestDetail
                    where leaveRequestDetail.Request        == leaveRequest.RecId
                        && (leaveRequestDetail.LeaveDate    >= payrollPayPeriod.PeriodStartDate
                        && leaveRequestDetail.LeaveDate     <= payrollPayPeriod.PeriodEndDate);

                if(leaveRequest)
                {
                    DialogButton dialogBtn;
                    
                    dialogBtn = Box::yesNo(strFmt('There is an open leave request for employee %1. Do you want to still submit timesheet?',localTimeSheetLine.EmpId) , DialogButton::No, 'Confirmation');
                    if (dialogBtn == DialogButton::No)
                    {
                        localTimeSheetLine = NVTimeSheetLines_DS.getNext();
                        continue;
                    }
                }

                NVTimesheetChangeHandler changeHelper;
                select changeHelper
                    where changeHelper.Worker == localTimeSheetLine.Worker;
                if(changeHelper)
                {
                    HcmWorker hcmWorker = HcmWorker::find(localTimeSheetLine.Worker);
                    warning(strFmt("Cannot submit timesheet line for worker %1. Please synchronise and try again.", hcmWorker.name()));
                    localTimeSheetLine = NVTimeSheetLines_DS.getNext();
                    continue;
                }

                if(localTimeSheetLine.Status == NVTimeSheetLineStatus::Draft)
                {
                    localTimeSheetLine.Status = NVTimeSheetLineStatus::Submitted;
                    localTimeSheetLine.write();
                }
                localTimeSheetLine = NVTimeSheetLines_DS.getNext();
            }
            NVTimeSheetLines_DS.reread();
            NVTimeSheetLines_DS.refresh();
        }

]]></Source>
