			<Control>
				<Name>RemoveLines</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();

            MultiSelectionHelper helper = MultiSelectionHelper::construct();            
            helper.parmDatasource(NVTimeSheetLines_DS);
            NVTimeSheetLines localTimeSheetLine = helper.getFirst();
    
            while(localTimeSheetLine)
            {
                if(localTimeSheetLine.Status == NVTimeSheetLineStatus::Draft)
                {
                    ttsbegin;
                    localTimeSheetLine.selectForUpdate(true);
                    localTimeSheetLine.delete();
                    ttscommit;
                }
                else
                {
                    warning(strFmt("Cannot delete submitted line for employee %1", localTimeSheetLine.EmpId));
                }
                localTimeSheetLine = NVTimeSheetLines_DS.getNext();
            }

            NVTimeSheetLines_DS.reread();
            NVTimeSheetLines_DS.refresh();

        }

]]></Source>
