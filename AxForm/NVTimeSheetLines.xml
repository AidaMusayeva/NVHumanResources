						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        /// <returns></returns>
        public int active()
        {
            int ret;

            ret = super();

            NVTimeSheetDataImport.enabled(NvTimeSheetHeader.Status == NVTimeSheetStatus::Draft);
            


            TransDate   thismonth = DateStartMth(NvTimeSheetHeader.LastDateOfMonth);
            TransDate   currentDate = thismonth;
            for(int Counter = 1; Counter <= 31; counter++)
            {
            
                str controlname = strFmt('%1%2', 'HoursDay',counter);
                FormStringControl fieldControl = element.design().controlName(controlname);

                if (fieldControl)
                {
                    if(currentDate > endMth(thismonth))
                    fieldControl.visible(false);
                    else
                fieldControl.label(element.getDateString(currentDate));
                }
                currentDate = thismonth + counter;
            }

            for (int i = 1; i <= conLen(NvTimeSheetHeader.LeaveTypesSequencing); i += 2)
            {
                str abbrevation = conPeek(NvTimeSheetHeader.LeaveTypesSequencing, i);
                int fieldnumber = conPeek(NvTimeSheetHeader.LeaveTypesSequencing, i + 1);
            
                str controlname = strFmt('%1%2', 'LeaveType',fieldnumber);
                FormIntControl fieldControl = element.design().controlName(controlname);

                if (fieldControl)
                {
                    fieldControl.visible(true);
                    fieldControl.label(abbrevation);
                }
            }
            return ret;
        }

]]></Source>
