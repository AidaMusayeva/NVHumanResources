        super(_active);
    }

]]></Source>
			</Method>
			<Method>
				<Name>task</Name>
				<Source><![CDATA[
    /// <summary>
    /// Overrides standard command processing to intercept the +New button.
    /// Redirects +New to open NVGenerateOrder instead of creating empty records.
    /// </summary>
    /// <param name="_taskId">Command ID (e.g., #taskNew)</param>
    /// <returns>Command execution result</returns>
    public int task(int _taskId)
    {
        #Task
        int ret;

        if (_taskId == #taskNew)
        {
            element.openGenerateOrderForm();
            return 0;
        }

        ret = super(_taskId);
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>refreshAfterGenerate</Name>
				<Source><![CDATA[
    /// <summary>
    /// Refreshes the order list after successful order generation.
    /// Called by child forms (e.g., NVOrderSelection) after creating new orders.
    /// </summary>
    public void refreshAfterGenerate()
    {
        NVOrderHeader_ds.executeQuery();
        NVOrderLine_ds.executeQuery();
    }

]]></Source>
			</Method>
			<Method>
				<Name>doRefresh</Name>
				<Source><![CDATA[
    /// <summary>
    /// Centralized datasource refresh method.
    /// </summary>
    /// <param name="_lineRefreshNeeded">
    /// True for full refresh (executeQuery) - use after data modifications.
    /// False for light refresh (research) - use for UI updates only.
    /// </param>
    public void doRefresh(boolean _lineRefreshNeeded = false)
    {
        if (_lineRefreshNeeded)
        {
            NVOrderHeader_ds.executeQuery();
            NVOrderLine_ds.executeQuery();
        }
        else
        {
            NVOrderHeader_ds.research();
            NVOrderLine_ds.research();
        }
    }

]]></Source>
