			<Method>
				<Name>openGenerateOrderForm</Name>
				<Source><![CDATA[
    /// <summary>
    /// Opens the NVGenerateOrder form for filtering and order generation.
    /// Uses wait() to ensure synchronous execution and proper refresh after completion.
    /// </summary>
    /// <remarks>
    /// Form chain: NVOrderList → NVGenerateOrder → NVOrderSelection → back to NVOrderList
    /// The wait() call ensures all child forms complete before refreshing the list.
    /// </remarks>
    public void openGenerateOrderForm()
    {
        Args args;

        // Open NVGenerateOrder via MenuFunction — async, non-blocking
        // Refresh is handled by NVOrderSelection.notifyParentToRefresh() on closeOk()
        args = new Args(formStr(NVGenerateOrder));
        args.caller(element);

        new MenuFunction(menuItemDisplayStr(NVGenerateOrderMenuItem), MenuItemType::Display).run(args);
    }

]]></Source>
			</Method>
			<Method>
				<Name>openOrderDetails</Name>
				<Source><![CDATA[
    /// <summary>
    /// Opens the NVOrderDetails form for the selected order.
    /// Does not refresh the list after closing to preserve cursor position.
    /// </summary>
    public void openOrderDetails()
    {
        NVOrderHeader header;
        Args args;
        
        // Get current record
        header = NVOrderHeader_ds.cursor();
        
        if (!header.RecId)
        {
            error("@SYS18447");
            return;
        }
        
        args = new Args();
        args.name(formStr(NVOrderDetails));
        args.record(header);
        args.caller(element);
        
        FormRun formRun = classfactory.formRunClass(args);
        formRun.init();
        formRun.run();
        formRun.wait();
        
        // No refresh - preserves cursor position on the same record
    }

]]></Source>
