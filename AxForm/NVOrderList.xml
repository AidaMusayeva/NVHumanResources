]]></Source>
			</Method>
			<Method>
				<Name>activate</Name>
				<Source><![CDATA[
    /// <summary>
    /// Handles form activation.
    /// Called when the form receives focus (e.g., returning from a child form).
    /// Refreshes workflow button state in case status changed in a child form.
    /// </summary>
    /// <param name="_active">True if form is being activated, false if deactivated</param>
    public void activate(boolean _active)
