				<Source><![CDATA[
/// <summary>
/// Main list form for employment orders.
/// Displays order headers and lines, provides navigation to generation and details forms.
/// </summary>
/// <remarks>
/// Form flow:
/// 1. User clicks +New → Opens NVGenerateOrder (filter form)
/// 2. NVGenerateOrder → NVOrderSelection (employee selection)
/// 3. NVOrderSelection generates orders and calls refreshAfterGenerate()
/// 4. List refreshes to show new orders
///
/// The form overrides the standard +New behavior to open the generation workflow
/// instead of creating empty records.
/// </remarks>
[Form]
public class NVOrderList extends FormRun
{

}
]]></Source>
			</Method>
