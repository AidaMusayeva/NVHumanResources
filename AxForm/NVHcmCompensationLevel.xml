						<Source><![CDATA[
        void clicked()
        {
            HcmCompensationLevel save;

            save = hcmCompensationLevel.data();

            HcmCompensationLevel::upDown(NoYes::No, hcmCompensationLevel);          

            hcmCompensationLevel_ds.research();
            HcmCompensationLevel_ds.positionToRecord(save);

            super();
        }

]]></Source>
