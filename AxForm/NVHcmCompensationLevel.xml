						<Name>write</Name>
						<Source><![CDATA[
        public void write()
        {
            super();

            // Refresh the position of the newly written compensation level to account for changes in line number
            hcmCompensationLevel_ds.research();
        }

]]></Source>
					</Method>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret;
        
            ret = super();

            InternalGrade.visible(HcmCompensationLevel.NVInternalGrade == NoYes::Yes);
            LegalGrade.visible(HcmCompensationLevel.NVLegalGrade == NoYes::Yes);
        
            return ret;
        }

]]></Source>
