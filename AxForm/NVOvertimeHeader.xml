				<Fields>
					<Field>
						<DataField>PayPeriod</DataField>
						<Methods>
							<Method>
								<Name>lookup</Name>
								<Source><![CDATA[
            /// <summary>
            ///
            /// </summary>
            /// <param name = "_formControl"></param>
            /// <param name = "_filterStr"></param>
            public void lookup(FormControl _formControl, str _filterStr)
            {

                Query query = new Query();
                QueryBuildDataSource queryBuildDataSource;
                QueryBuildRange queryBuildRange;
  
                
              
                
                SysTableLookup sysTableLookup = SysTableLookup::newParameters(tableNum(PayrollPayPeriod), _formControl);
                sysTableLookup.addLookupfield(fieldNum(PayrollPayPeriod, RecId));
                sysTableLookup.addLookupfield(fieldNum(PayrollPayPeriod, PeriodStartDate));
                sysTableLookup.addLookupfield(fieldNum(PayrollPayPeriod, PeriodEndDate));
                sysTableLookup.addSelectionField(fieldNum(PayrollPayPeriod, RecId));

                queryBuildDataSource = query.addDataSource(tableNum(PayrollPayPeriod));
  
                queryBuildRange = queryBuildDataSource.addRange(fieldNum(PayrollPayPeriod, PayCycle));
                queryBuildRange.value(queryValue(PayrollPayCycle::findByPayCycle(NVEmpOvertimeHeader.PayCycleId).RecId));
                
                queryBuildDataSource.addRange(fieldNum(PayrollPayPeriod, PeriodStatus)).value(queryValue(PayrollPeriodStatus::Open));

                sysTableLookup.parmQuery(query);
                sysTableLookup.performFormLookup();

                //super(_formControl, _filterStr);
        
            }

]]></Source>
							</Method>
