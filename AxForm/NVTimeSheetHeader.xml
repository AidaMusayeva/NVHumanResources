		<DataControls xmlns="">
			<Control>
				<Name>CloseTimeSheet</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void clicked()
        {
            NVTimeSheetLines    timeSheetLines;

            super();
            if(NvTimeSheetHeader.Status == NVTimeSheetStatus::Draft)
            {

                select firstonly timeSheetLines
                    where timeSheetLines.TimeSheetHeader == NvTimeSheetHeader.RecId
                    && timeSheetLines.Status == NVTimeSheetLineStatus::Draft;
                if(timeSheetLines.RecId)
                {
                    warning('Timesheet cannot be closed while it has Open entries');
                }
                else
                {
                    NvTimeSheetHeader.Status = NVTimeSheetStatus::Closed;
                    while select timeSheetLines
                         where timeSheetLines.TimeSheetHeader == NvTimeSheetHeader.RecId
                    {
                        NVHcmESSChangeLog::insertRef(timeSheetLines.TableId, timeSheetLines.RecId);
                    }
                }
            }
            
            NvTimeSheetHeader_DS.refresh();
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
			<Control>
				<Name>OpenTimeSheet</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void clicked()
        {
            super();
            if(NvTimeSheetHeader.Status == NVTimeSheetStatus::Closed)
                NvTimeSheetHeader.Status = NVTimeSheetStatus::Draft;
            
            NvTimeSheetHeader_DS.refresh();
        }

]]></Source>
					</Method>
