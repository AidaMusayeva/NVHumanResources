					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        /// <returns></returns>
        public int active()
        {
            int ret;
        
            ret = super();
            CloseTimeSheet.enabled(NvTimeSheetHeader.Status == NVTimeSheetStatus::Draft);
            OpenTimeSheet.enabled(NvTimeSheetHeader.Status == NVTimeSheetStatus::Closed);
            NVTimeSheetDataImport.enabled(NvTimeSheetHeader.Status == NVTimeSheetStatus::Draft);
            NvTimeSheetHeader_DS.allowDelete(NvTimeSheetHeader.Status == NVTimeSheetStatus::Draft);
            return ret;
        }

]]></Source>
